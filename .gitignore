# ── Nextflow ──────────────────────────────────────────────────────────────────
.nextflow/
.nextflow.log*
work/
.nextflow.cache/

# ── Resultados (gerados na execução — não versionar dados brutos) ─────────────
results/

# ── Dados brutos e arquivos grandes ──────────────────────────────────────────
*.fastq
*.fq
*.fastq.gz
*.fq.gz
*.sra
*.bam
*.sam

# ── Semente (arquivo de dados — versionar apenas se pequeno e público) ────────
# Semente cox1 pequena e pública — versionada para reprodutibilidade:
data/seeds/*.fasta
!data/seeds/*.fasta

# ── Python / scripts auxiliares ───────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Arquivo de contexto local (apenas no PC, não versionar) ──────────────────
CONTEXT.md
docs/CONTEXTO_TCC.md

# ── Sistema operacional ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Bancos de dados (arquivos grandes, baixados localmente) ──────────────────
data/databases/

# ── VS Code ───────────────────────────────────────────────────────────────────
.vscode/
*.code-workspace
docs/TCC_ATUALIZADO.md

# ── LaTeX / TCC (apenas local, compilado via Overleaf) ───────────────────────
latex/
latex-overleaf.zip
1latex-overleaf.zip

# ── Materiais privados de estudo / defesa (não versionar) ────────────────────
Apresentação/

# ── Papers de referência e manuais (grandes, não autoria) ────────────────────
Papers Mitochondrion/
docs/manual tcc uern.pdf

# ── Logs e estado de execução (runtime, não versionar) ──────────────────────
logs/*
