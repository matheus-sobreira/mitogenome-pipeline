/*
 * Configuração global do pipeline mitogenome-pipeline
 * Nextflow DSL2
 */

nextflow.enable.dsl = 2

// ── Parâmetros do pipeline ─────────────────────────────────────────────────

params {

    // ── Entradas obrigatórias ────────────────────────────────────────────
    sra_accession = null       // Acesso SRA (ex: 'SRR36152783')
    seed          = null       // Caminho do arquivo FASTA com a semente
    outdir        = 'results'  // Diretório de saída

    // ── Download SRA ─────────────────────────────────────────────────────
    // Limite de reads para testes (null = baixar tudo; number = max pairs)
    sra_max_reads = null

    // ── Parâmetros do NOVOPlasty ─────────────────────────────────────────
    genome_range             = '13000-14500'  // Tamanho esperado do mtDNA (bp)
    k_mer                    = 39              // K-mer padrão
    novoplasty_kmers         = null            // K-mers para tentar (ex: '39,33')
    novoplasty_max_iterations = 3              // Iterações com re-seeding por k-mer
    max_memory               = null            // null = auto-detectar RAM disponível; inteiro = usar diretamente (GB)
    read_length              = 150             // Comprimento das leituras (bp) — fallback se Pilot QC for pulado
    insert_size              = 300             // Tamanho do inserto da biblioteca

    // ── Parâmetros do Trim Galore ─────────────────────────────────────────
    trim_quality  = 20   // Score de qualidade Phred mínimo
    min_length    = 50   // Comprimento mínimo da leitura após trimming

    // ── Pilot QC (determinação automática de max_reads) ───────────────────
    // Se sra_max_reads = null, o pipeline baixa uma amostra piloto, analisa
    // qualidade e fração mitocondrial, e recomenda o número ideal de reads.
    pilot_reads      = 500000  // Reads por arquivo na amostra piloto
    target_coverage  = 500     // Cobertura alvo do mitogenoma (×)
    mito_fraction    = null    // null = medir com bwa; valor = usar diretamente

    // ── Medição da fração mitocondrial (bwa) ──────────────────────────────
    // pilot_reference: FASTA de um mitogenoma COMPLETO. Sem ele, a medição usa
    // a seed (COX1, ~1,5 kb) e escala para genome_range assumindo cobertura
    // uniforme — premissa declarada no relatório. Ver DEC-06.
    pilot_reference = null
    // Opções extras do bwa mem. Para seeds inter-específicas divergentes
    // (>10%), '-B 3 -k 15' relaxa o alinhamento. Vazio = defaults do bwa.
    pilot_bwa_opts  = ''

    // Teto de segurança da recomendação, REPORTADO quando aplicado, para que um
    // valor limitado nunca seja confundido com um valor medido (DEC-10).
    // O piso foi removido: era da mesma família do piso de fração — existia para
    // proteger de um estimador quebrado e só forçava download desnecessário.
    pilot_max_reads_cap = 25000000

    // ── Constantes do NOVOPlasty, medidas em 13/08/2026 (DEC-13) ──────────
    // O montador lê reads sequencialmente até encher a memória e ignora o
    // resto; baixar além disso é desperdício puro. Quem limita o volume útil
    // é a janela de intake, não o alvo de cobertura.
    //   reads_lidos = min(reads_por_gb × memória, fornecidos × retenção)
    // ⚠️ reads_por_gb foi medido com reads de 150 bp (5 pontos, 2–8 GB, desvio
    // de 0,005%). A memória guarda BASES, então a constante quase certamente
    // escala com o comprimento do read — não verificado ainda.
    novoplasty_reads_per_gb = 1691018
    novoplasty_retention    = 0.85   // observado 82–92%; conservador
    trim_loss_estimate      = 0.10   // medido 7,6% em A. leari

    // ── Validação pós-montagem (DEC-20) ───────────────────────────────────
    // Mapeia a amostra piloto de volta contra a montagem circularizada e
    // sinaliza regiões com razão de profundidade fora de [low, high]×mediana:
    // razão baixa = repeat superexpandido (cópias a mais na montagem); razão
    // alta = repeat colapsado. Motivada pelo VNTR de A. leari (14/08/2026):
    // montagem circular de 18.058 bp, dentro do genome_range, com ~3 cópias
    // espúrias de um repeat de 298 bp — razão de profundidade 0,22 no array.
    // A amostra piloto passa a ser coletada mesmo com sra_max_reads forçado.
    assembly_validation   = true
    validation_window     = 200   // Janela da varredura (bp)
    validation_ratio_low  = 0.5   // Abaixo disto × mediana → SUPEREXPANSAO
    validation_ratio_high = 2.0   // Acima disto × mediana → COLAPSO

    // ── Rearbitragem de montagem (DEC-22) ─────────────────────────────────
    // ALERTA de repeat = o número de cópias foi um sorteio de caminho do
    // montador (com insert < unidade, a informação não está nos reads).
    // Tratamento: re-sortear o pool a partir do .sra local (semente nova,
    // zero rede), re-montar e deixar o detector arbitrar. Mantém o .sra no
    // work dir do SRA_DOWNLOAD (~10 GB) até a limpeza do work/.
    assembly_retry    = true
    retry_seed_offset = 1000  // (modo stratified) Semente da retentativa = pilot_seed + offset
    // (modo 'head', DEC-23) Deslocamento do início do bloco contíguo na
    // retentativa, como fração do run. Em head a semente NÃO altera quais spots
    // entram — é este offset que re-sorteia o pool. Agenda de DEC-23:
    // 0→50→25→75%; com uma única retentativa, 50% (0.5). Ignorado em stratified.
    retry_start_offset = 0.5

    // ── Amostragem (Pilot QC e download) ──────────────────────────────────
    // Modos disponíveis:
    //   head       — N spots contíguos a partir do início do run
    //   stratified — N spots em janelas equidistantes ao longo do run
    //   dense      — idem com mais janelas (referência do C2ST)
    //
    // MEDIÇÃO (piloto) usa 'stratified': precisa de representatividade para
    // julgar se o run é plano (DEC-01). Amostragem por conveniência falsearia
    // a medição da fração mitocondrial.
    pilot_sampling      = 'stratified'
    pilot_windows       = 10     // Janelas no modo stratified
    pilot_dense_windows = 500    // Janelas no modo dense
    pilot_seed          = 42     // Semente do LCG — reprodutibilidade bit-a-bit

    // DOWNLOAD (montagem) usa 'head' (contíguo) — DEC-23. Estratificar o
    // download interage com a janela de intake do NOVOPlasty: quais janelas
    // cabem antes do corte de memória depende do tamanho da janela, que muda
    // com o volume, alimentando o montador com pools instáveis. Medido: 8M
    // estratificado superexpandiu um VNTR (18.058 bp); 8M contíguo montou
    // certo (16.986 bp). A representatividade fica no piloto; o montador não
    // precisa dela. Refina o DEC-02. 'stratified' permanece para comparação.
    sra_sampling = 'head'
    sra_windows  = 50

    // ── Parâmetros do MITOS2 (Fase 2 — Anotação) ──────────────────────
    // mitos2_db: caminho COMPLETO para a pasta do banco (ex: data/databases/refseq89m).
    // Internamente o pipeline extrai: -r <nome_banco> -R <diretorio_pai>
    // Download: wget https://zenodo.org/record/4284483/files/refseq89m.tar.bz2
    //           tar -xjf refseq89m.tar.bz2 -C data/databases/
    mitos2_db    = null  // Caminho para data/databases/refseq89m (null = pular anotação)
    genetic_code = 2     // Código genético mitocondrial: 2=vertebrado, 5=invertebrado

    // ── Identificação do organismo (para GenBank e summary) ────────────
    organism     = null  // Nome binomial (ex: 'Anodorhynchus leari')
}

// ── Docker ─────────────────────────────────────────────────────────────────

docker {
    enabled      = true
    fixOwnership = true   // Corrige permissões dos arquivos gerados dentro do container
}

// ── Recursos por processo ──────────────────────────────────────────────────

process {

    withName: 'SRA_PILOT_SAMPLE' {
        container = 'ghcr.io/matheus-sobreira/mitogenome-pipeline/sra-tools:1.0'
        cpus      = 2
        memory    = '4 GB'
    }

    withName: 'PILOT_QC' {
        container = 'ghcr.io/matheus-sobreira/mitogenome-pipeline/pilot-qc:1.0'
        cpus      = 4
        memory    = '6 GB'
    }

    withName: 'ASSEMBLY_VALIDATION' {
        container = 'ghcr.io/matheus-sobreira/mitogenome-pipeline/pilot-qc:1.0'
        cpus      = 4
        memory    = '6 GB'
    }

    withName: 'SRA_DOWNLOAD' {
        container = 'ghcr.io/matheus-sobreira/mitogenome-pipeline/sra-tools:1.0'
        cpus      = 4
        memory    = '6 GB'
    }

    withName: 'FASTQC' {
        container = 'ghcr.io/matheus-sobreira/mitogenome-pipeline/fastqc:1.0'
        cpus      = 4
        memory    = '6 GB'
    }

    withName: 'TRIM_GALORE' {
        container = 'ghcr.io/matheus-sobreira/mitogenome-pipeline/trim-galore:1.0'
        cpus      = 4
        memory    = '6 GB'
    }

    // NOVOPLASTY usa a imagem do BioContainers, não uma do namespace deste
    // projeto. A licença do NOVOPlasty permite redistribuição dentro de um
    // trabalho maior apenas "solely in Object or Binary form" (cláusula 2c), e
    // ele é um script Perl — ou seja, forma de fonte. Publicar uma imagem
    // nossa contendo o script não se encaixa nessa autorização.
    // Referenciar a imagem pública do BioContainers evita que este projeto
    // redistribua o software, e é também a convenção do nf-core.
    // A versão fica fixada pela TAG do container; o módulo chama
    // `NOVOPlasty.pl` (nome estável entre versões) para não duplicar a versão
    // em dois lugares.
    withName: 'NOVOPLASTY' {
        container = 'quay.io/biocontainers/novoplasty:4.3.1--pl5321hdfd78af_1'
        cpus      = 4
        memory    = '12 GB'
    }

    withName: 'MITOS2' {
        container = 'ghcr.io/matheus-sobreira/mitogenome-pipeline/mitos2:1.0'
        cpus      = 4
        memory    = '8 GB'
    }

    // ── Cadeia de rearbitragem (DEC-22) — aliases com publishDir próprios ──
    // Sem estes overrides, as retentativas publicariam nos mesmos caminhos da
    // tentativa 0 e SOBRESCREVERIAM os artefatos dela (mesmos nomes de arquivo).
    withName: 'RESAMPLE_POOL' {
        container = 'ghcr.io/matheus-sobreira/mitogenome-pipeline/sra-tools:1.0'
        cpus      = 4
        memory    = '6 GB'
    }

    withName: 'TRIM_GALORE_RETRY' {
        container  = 'ghcr.io/matheus-sobreira/mitogenome-pipeline/trim-galore:1.0'
        cpus       = 4
        memory     = '6 GB'
        publishDir = [path: { "${params.outdir}/qc/trim_galore_retry1" },
                      mode: 'copy', pattern: '*_trimming_report.txt']
    }

    withName: 'NOVOPLASTY_RETRY' {
        container  = 'quay.io/biocontainers/novoplasty:4.3.1--pl5321hdfd78af_1'
        cpus       = 4
        memory     = '12 GB'
        publishDir = [path: { "${params.outdir}/assembly_retry1" }, mode: 'copy']
    }

    withName: 'ASSEMBLY_VALIDATION_RETRY' {
        container  = 'ghcr.io/matheus-sobreira/mitogenome-pipeline/pilot-qc:1.0'
        cpus       = 4
        memory     = '6 GB'
        publishDir = [path: { "${params.outdir}/qc/assembly_validation_retry1" }, mode: 'copy']
    }
}

// ── Perfis de execução ─────────────────────────────────────────────────────

profiles {

    // Perfil de teste (dados pequenos, roda no PC)
    test {
        includeConfig 'conf/test.config'
    }

    // Perfil para Anodorhynchus leari (arara-azul-de-lear) — objeto principal do TCC
    a_leari {
        includeConfig 'conf/a_leari.config'
    }

    // Perfil para Anodorhynchus hyacinthinus (arara-azul-grande) — validação cruzada
    a_hyacinthinus {
        includeConfig 'conf/a_hyacinthinus.config'
    }

    // Perfil para Brachyplatystoma filamentosum (piraíba) — caso-teste de
    // viabilidade em dado de CAPTURA UCE (não-WGS); ver conf/b_filamentosum.config
    b_filamentosum {
        includeConfig 'conf/b_filamentosum.config'
    }

    // Perfil para Apis mellifera (abelha) — validação multi-espécie, INVERTEBRADO
    // (código genético 5). Caso-teste em captura híbrida; ver conf/a_mellifera.config
    a_mellifera {
        includeConfig 'conf/a_mellifera.config'
    }

    // Perfil para Oreochromis niloticus (tilápia-do-nilo) — VALIDAÇÃO POSITIVA:
    // monta um mitogenoma conhecido a partir de reads de um projeto independente
    // (pipeline cego ao gabarito NC_013663). Ver conf/o_niloticus.config
    o_niloticus {
        includeConfig 'conf/o_niloticus.config'
    }

    // Perfil para servidor de alto desempenho (HPC/Slurm) — fase futura
    // hpc {
    //     includeConfig 'conf/hpc.config'
    // }
}

// ── Diretório de trabalho por espécie + timestamp ──────────────────────────
// Estrutura: work/<especie>/<AAAA-MM-DD_HHhMM>/
// Cada execução fica isolada. Para -resume de um run anterior:
//   nextflow run main.nf -profile a_leari -resume -w work/a_leari/2026-04-12_14h30
import java.time.LocalDateTime
import java.time.format.DateTimeFormatter

def runTimestamp = LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd_HH'h'mm"))
def speciesLabel = params.organism
    ? params.organism.toLowerCase().replaceAll(/\s+/, '_').replaceAll(/^(\w)\w+_/, '$1_')
    : 'default'

workDir = "work/${speciesLabel}/${runTimestamp}"
