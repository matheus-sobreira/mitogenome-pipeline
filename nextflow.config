/*
 * Configuração global do pipeline mitogenome-pipeline
 * Nextflow DSL2
 */

nextflow.enable.dsl = 2

// ── Parâmetros do pipeline ─────────────────────────────────────────────────

params {

    // ── Entradas obrigatórias ────────────────────────────────────────────
    sra_accession = null       // Acesso SRA (ex: 'SRR36152783')
    seed          = null       // Caminho do arquivo FASTA com a semente
    outdir        = 'results'  // Diretório de saída

    // ── Download SRA ─────────────────────────────────────────────────────
    // Limite de reads para testes (null = baixar tudo; number = max pairs)
    sra_max_reads = null

    // ── Parâmetros do NOVOPlasty ─────────────────────────────────────────
    genome_range             = '13000-14500'  // Tamanho esperado do mtDNA (bp)
    k_mer                    = 39              // K-mer padrão
    novoplasty_kmers         = null            // K-mers para tentar (ex: '39,33')
    novoplasty_max_iterations = 3              // Iterações com re-seeding por k-mer
    max_memory               = 12              // RAM máxima para NOVOPlasty (GB)
    read_length              = 150             // Comprimento das leituras (bp)
    insert_size              = 300             // Tamanho do inserto da biblioteca

    // ── Parâmetros do Trim Galore ─────────────────────────────────────────
    trim_quality  = 20   // Score de qualidade Phred mínimo
    min_length    = 50   // Comprimento mínimo da leitura após trimming
}

// ── Docker ─────────────────────────────────────────────────────────────────

docker {
    enabled      = true
    fixOwnership = true   // Corrige permissões dos arquivos gerados dentro do container
}

// ── Recursos por processo ──────────────────────────────────────────────────

process {

    withName: 'SRA_DOWNLOAD' {
        container = 'mitogenome-pipeline/sra-tools:1.0'
        cpus      = 4
        memory    = '6 GB'
    }

    withName: 'FASTQC' {
        container = 'mitogenome-pipeline/fastqc:1.0'
        cpus      = 4
        memory    = '6 GB'
    }

    withName: 'TRIM_GALORE' {
        container = 'mitogenome-pipeline/trim-galore:1.0'
        cpus      = 4
        memory    = '6 GB'
    }

    withName: 'NOVOPLASTY' {
        container = 'mitogenome-pipeline/novoplasty:1.0'
        cpus      = 4
        memory    = '12 GB'
    }
}

// ── Perfis de execução ─────────────────────────────────────────────────────

profiles {

    // Perfil de teste (dados pequenos, roda no PC)
    test {
        includeConfig 'conf/test.config'
    }

    // Perfil para Anodorhynchus leari (arara-azul-de-lear) — objeto principal do TCC
    a_leari {
        includeConfig 'conf/a_leari.config'
    }

    // Perfil para servidor de alto desempenho (HPC/Slurm) — fase futura
    // hpc {
    //     includeConfig 'conf/hpc.config'
    // }
}
