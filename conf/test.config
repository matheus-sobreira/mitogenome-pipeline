/*
 * Perfil de TESTE — Diploprion bifasciatus (peixe-sabão barrado)
 *
 * Espécie: Diploprion bifasciatus (Perciformes)
 * Referência mtDNA: PZ143763.1 (16.805 bp, GC ~46.0%)
 * Vantagem: mitogenoma publicado a partir DESTE dataset,
 *           download compacto (~1.2 GB), WGS genuíno NovaSeq X Plus.
 *
 * HOW TO RUN:
 *   nextflow run main.nf -profile test
 */

params {

    // ── Acesso SRA ──────────────────────────────────────────────────────────
    // Dataset WGS de Diploprion bifasciatus:
    //   SRR36182901 — WGS paired-end, NovaSeq X Plus, seleção RANDOM
    //   Total: 12.0M spots / ~1.2 GB download / 2x151bp
    //   ~3.6x cobertura nuclear → estimativa ~360-2250x cobertura mtDNA
    //
    sra_accession = 'SRR36182901'

    // Semente: gene cox1 de D. bifasciatus (PZ143763.1, 1.560 bp, GC 46.3%)
    seed = "${projectDir}/data/seeds/d_bifasciatus_cox1.fasta"

    // Referência do Pilot QC para MEDIR a fração mitocondrial (não usada na
    // montagem). ⚠️ PZ143763.1 foi publicada A PARTIR DESTE MESMO dataset, então
    // aqui há circularidade — inevitável, e sem consequência por ser perfil de
    // smoke test, que não sustenta afirmação científica. Nos perfis das araras
    // a referência é independente do dado medido. Ver DEC-06.
    pilot_reference = "${projectDir}/data/references/PZ143763.1.fasta"

    outdir = 'results/test_d_bifasciatus'

    // ── NOVOPlasty — D. bifasciatus mtDNA ──────────────────────────────────
    genome_range             = '15000-18500'   // PZ143763.1 tem 16.805 bp
    novoplasty_kmers         = '33'
    novoplasty_max_iterations = 5
    k_mer                    = 33
    read_length              = 151
    insert_size              = 300

    // ── Trimming ─────────────────────────────────────────────────────────
    trim_quality = 20
    min_length   = 50
    // ── MITOS2 (Fase 2) ─────────────────────────────────────────────
    genetic_code = 2     // Vertebrado mitocondrial (peixe é vertebrado)
    organism     = 'Diploprion bifasciatus'
    // mitos2_db não definido: etapa de anotação é opcional no perfil de teste
}
