/*
 * Perfil de TESTE — C. elegans (N2)
 *
 * Espécie: Caenorhabditis elegans (nematódeo modelo)
 * Referência mtDNA: NC_001328.1 (~13.794 bp)
 * Vantagem: genoma nuclear pequeno (~100 Mb) → datasets muito menores,
 *           ~10-12% das leituras são mitocondriais (alta taxa de cópia).
 *
 * HOW TO RUN:
 *   nextflow run main.nf -profile test
 *
 * Para usar um acesso SRA diferente:
 *   nextflow run main.nf -profile test --sra_accession SRR_OUTRO
 */

params {

    // ── Acesso SRA ──────────────────────────────────────────────────────────
    // Dataset verificado de C. elegans (N2):
    //   SRR36152783 — WGS paired-end, Illumina
    //   Total completo: 1.18 GB comprimido / 4.39 Gb bases / 14.6M read pairs
    //   Com limite de 500k reads: ~40 MB download / ~300 MB FASTQ
    //   Cobertura estimada do mtDNA: ~544x (mínimo necessário: 30x)
    //
    sra_accession = 'SRR36152783'

    // Semente: gene cox1 do C. elegans (ver data/seeds/COMO_OBTER_SEMENTE.md)
    seed = "${projectDir}/data/seeds/c_elegans_cox1.fasta"

    outdir = 'results/test_c_elegans'

    // ── Limite de reads para teste rápido ───────────────────────────────────
    // 500.000 pares = ~150 Mb de dados brutos (150 bp reads)
    // C. elegans tem alta fração de mtDNA (~10-12%), então 500k leituras
    // devem gerar cobertura suficiente para montar o mtDNA completo (~1000x).
    sra_max_reads = 500000

    // ── NOVOPlasty — C. elegans mtDNA ──────────────────────────────────────
    genome_range = '13000-14500'   // NC_001328.1 tem 13.794 bp
    k_mer        = 39
    max_memory   = 12              // 12 GB disponíveis no Ubuntu
    read_length  = 150
    insert_size  = 300

    // ── Trimming ─────────────────────────────────────────────────────────
    trim_quality = 20
    min_length   = 50
}
