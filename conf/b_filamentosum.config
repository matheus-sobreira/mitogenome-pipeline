/*
 * Perfil — Brachyplatystoma filamentosum (piraíba / kumakuma)
 *
 * Espécie: Brachyplatystoma filamentosum (Siluriformes, Pimelodidae)
 * Referência mtDNA: PQ380008.1 (16.566 bp) — UFPA, 2024
 * Semente: cox1 do próprio PQ380008.1 (pos 5484-7034, 1.551 bp) — conspecífica
 *
 * ⚠️ CASO-TESTE DE VIABILIDADE (14/08/2026): o único SRA da espécie é
 * SRR14323300, uma biblioteca de CAPTURA UCE (targeted-capture, PCR), NÃO WGS,
 * de outro laboratório (UNESP) e outro projeto (PRJNA724721). A sondagem mediu
 * bycatch mitocondrial esparso: breadth ≥1× de apenas 38%, mediana 0×, 43% do
 * mitogenoma em buracos (CV 4,86). NÃO se espera montagem completa — este perfil
 * existe para observar o modo de falha do pipeline em dado não-WGS. Ver a sonda
 * em Projeto/Dados/2026-08-14-sonda-bfilamentosum-SRR14323300.txt no vault.
 *
 * HOW TO RUN:
 *   nextflow run main.nf -profile b_filamentosum
 */

params {

    sra_accession = 'SRR14323300'

    // Semente conspecífica (a mais favorável possível)
    seed = "${projectDir}/data/seeds/b_filamentosum_cox1.fasta"

    // Referência do Pilot QC = o próprio mitogenoma depositado (mede a fração
    // e, aqui, a distribuição — que é o que reprova o dataset)
    pilot_reference = "${projectDir}/data/references/PQ380008.1.fasta"

    outdir = 'results/b_filamentosum'

    // ── NOVOPlasty ─────────────────────────────────────────────────────────
    // PQ380008.1 tem 16.566 bp
    genome_range              = '15000-18000'
    novoplasty_kmers          = '39,33'
    novoplasty_max_iterations = 5
    k_mer                     = 39
    read_length               = 97    // ~97 bp (HiSeq 1000; 240 Mbp / 2,47M reads)
    insert_size               = 300

    // ── Trimming ─────────────────────────────────────────────────────────
    trim_quality = 20
    min_length   = 50

    // ── MITOS2 ────────────────────────────────────────────────────────────
    // mitos2_db não definido: anotação pulada (foco é a montagem)
    genetic_code = 2     // Vertebrado mitocondrial (peixe)
    organism     = 'Brachyplatystoma filamentosum'
}
