/*
 * Perfil — Apis mellifera (abelha-europeia)
 *
 * Espécie: Apis mellifera (Hymenoptera, Apidae) — INVERTEBRADO
 * Referência mtDNA: OZ471064.1 (17.104 bp) — assembly EBI via MitoHiFi (PacBio)
 * Semente: cox1 de NC_001566.1 (mitogenoma anotado clássico, pos 1794-3354,
 *          1.561 bp) — independente da referência de comparação
 *
 * ⚠️ CÓDIGO GENÉTICO 5 (invertebrado), não 2 — Apis é inseto.
 *
 * ⚠️ CASO-TESTE (14/08/2026): o SRA usado (SRR40103703) é CAPTURA HÍBRIDA
 * (Targeted-Capture / Hybrid Selection), NÃO WGS — mtDNA entra como bycatch.
 * É Illumina paired-end 150 bp (formato compatível) e ~16× maior que o caso
 * do bagre, o que dá chance real de o bycatch cobrir o mitogenoma. Não é a
 * fonte do OZ471064.1 (esse veio de PacBio/MitoHiFi) — mas isso é DESEJÁVEL:
 * montagem independente comparada a referência independente = validação real,
 * como nas araras. Se falhar, o fallback WGS é SRR39834167 (SRX34507629).
 *
 * HOW TO RUN:
 *   nextflow run main.nf -profile a_mellifera
 */

params {

    sra_accession = 'SRR40103703'   // captura híbrida; fallback WGS: SRR39834167

    // Semente COX1 conspecífica, de um mitogenoma anotado independente
    seed = "${projectDir}/data/seeds/a_mellifera_cox1.fasta"

    // Referência do Pilot QC = mitogenoma completo (mede fração E distribuição)
    pilot_reference = "${projectDir}/data/references/OZ471064.1.fasta"

    outdir = 'results/a_mellifera'

    // ── NOVOPlasty ─────────────────────────────────────────────────────────
    // OZ471064.1 tem 17.104 bp; mitogenomas de inseto variam na região AT-rica
    genome_range              = '15000-19000'
    novoplasty_kmers          = '39,33'
    novoplasty_max_iterations = 5
    k_mer                     = 39
    read_length               = 150
    insert_size               = 300

    // ── Trimming ─────────────────────────────────────────────────────────
    trim_quality = 20
    min_length   = 50

    // ── MITOS2 ────────────────────────────────────────────────────────────
    // mitos2_db não definido: anotação pulada (foco é a montagem)
    genetic_code = 5     // Invertebrado mitocondrial (inseto) — NÃO 2
    organism     = 'Apis mellifera'
}
