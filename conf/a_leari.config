/*
 * Perfil — Anodorhynchus leari (arara-azul-de-lear)
 *
 * Espécie: Anodorhynchus leari (Psittaciformes)
 * Referência mtDNA do gênero: NC_082165.1 — A. hyacinthinus (16.999 bp)
 * Semente: cox1 de A. hyacinthinus (NC_082165.1, pos 5359-6906, 1.548 bp)
 *
 * HOW TO RUN:
 *   nextflow run main.nf -profile a_leari
 */

params {

    // ── Acesso SRA ──────────────────────────────────────────────────────────
    // Dataset WGS de Anodorhynchus leari:
    //   SRR28399504 — WGS paired-end, HiSeq X Ten, Iridian Genomes (2024)
    //   Total: 118.5M spots / 35.5G bases / ~10.7 GB download
    //
    sra_accession = 'SRR28399504'

    // sra_max_reads não definido → SRA_PILOT analisa automaticamente
    // a qualidade das reads e recomenda o número ideal de reads.
    // Para forçar um valor: nextflow run main.nf -profile a_leari --sra_max_reads 20000000

    // Semente: gene cox1 de A. hyacinthinus (NC_082165.1, 1.548 bp)
    seed = "${projectDir}/data/seeds/a_hyacinthinus_cox1.fasta"

    outdir = 'results/a_leari'

    // ── NOVOPlasty — A. leari mtDNA ────────────────────────────────────────
    // A. hyacinthinus tem 16.999 bp; espera-se valor muito próximo para A. leari
    genome_range             = '15500-18500'
    novoplasty_kmers         = '39,33'
    novoplasty_max_iterations = 5
    k_mer                    = 39
    insert_size              = 300

    // ── Trimming ─────────────────────────────────────────────────────────
    trim_quality = 20
    min_length   = 50
    // ── MITOS2 (Fase 2) ─────────────────────────────────────────────
    // Baixar o banco uma vez antes de executar:
    //   mkdir -p data/databases
    //   wget https://zenodo.org/record/4284483/files/refseq89m.tar.bz2
    //   tar -xjf refseq89m.tar.bz2 -C data/databases/
    mitos2_db    = "${projectDir}/data/databases/refseq89m"
    genetic_code = 2     // Vertebrado mitocondrial (ave)
    organism     = 'Anodorhynchus leari'
}
