/*
 * Perfil — Oreochromis niloticus (tilápia-do-nilo)
 *
 * VALIDAÇÃO POSITIVA MULTI-ESPÉCIE (controle positivo).
 * Objetivo: provar que o pipeline monta um mitogenoma CONHECIDO a partir de
 * reads de um PROJETO INDEPENDENTE do que gerou a referência — teste que os
 * casos de 14–15/08 (bagre/Apis) não puderam cumprir (0 circularizações).
 *
 * Desenho não-circular (o pipeline é CEGO ao gabarito):
 *   - Reads (montagem)  : ERR12353640 — WGS Illumina NovaSeq X, paired 150 bp,
 *                         24,2M spots / ~2,2 GB, BioProject PRJEB70924 (2024).
 *   - Semente + pilot   : congênere Oreochromis andersonii (NC_037019.1),
 *                         ~96 % de identidade — simula o cenário de espécie nova,
 *                         igual ao que se fez com as araras (DEC-06).
 *   - Gabarito (held-out): O. niloticus NC_013663.1 (16.627 bp), submetido em
 *                         2009 pelo Pearl River Fisheries Institute — projeto
 *                         distinto do PRJEB70924. Usado SÓ na conferência final
 *                         (data/references/NC_013663_GABARITO.fasta), NUNCA pelo
 *                         pipeline. É isto que torna um "bate" uma prova real.
 *
 * HOW TO RUN:
 *   nextflow run main.nf -profile o_niloticus
 */

params {

    // ── Acesso SRA (reads da montagem) ──────────────────────────────────────
    sra_accession = 'ERR12353640'

    // sra_max_reads não definido → o Pilot QC mede fração/breadth/cobertura e
    // recomenda o volume (comportamento publicado). Se o run for fino demais,
    // paramos ANTES do prefetch de 2,2 GB — o piloto amostra por janelas remotas.

    // Semente: cox1 do congênere O. andersonii (NC_037019.1, 1.602 bp)
    seed = "${projectDir}/data/seeds/o_andersonii_cox1.fasta"

    // Referência do Pilot QC (MEDE a fração mitocondrial; não entra na montagem).
    // Congênere, para manter o pipeline cego ao gabarito de O. niloticus. Ver DEC-06.
    pilot_reference = "${projectDir}/data/references/NC_037019.1.fasta"

    outdir = 'results/o_niloticus'

    // ── NOVOPlasty — mtDNA de teleósteo ─────────────────────────────────────
    // Esperado ~16.627 bp (niloticus); congêneres Oreochromis 16.622–16.663 bp.
    genome_range              = '16000-17200'
    novoplasty_kmers          = '39,33'
    novoplasty_max_iterations = 5
    k_mer                     = 39
    insert_size               = 300

    // ── Trimming ─────────────────────────────────────────────────────────
    trim_quality = 20
    min_length   = 50

    // ── Anotação (MITOS2) ───────────────────────────────────────────────
    // Desativada: este teste checa se a MONTAGEM bate com o gabarito
    // (comprimento + identidade + validação de profundidade DEC-20), não a
    // anotação. Para anotar depois, aponte mitos2_db ao banco refseq89m.
    mitos2_db    = null
    genetic_code = 2     // Vertebrado mitocondrial (peixe)
    organism     = 'Oreochromis niloticus'
}
