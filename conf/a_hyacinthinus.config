/*
 * Perfil — Anodorhynchus hyacinthinus (arara-azul-grande)
 *
 * Espécie: Anodorhynchus hyacinthinus (Psittaciformes)
 * Referência mtDNA: NC_082165.1 (16.999 bp)
 * Semente: cox1 de A. leari (montagem do pipeline, pos 6780-8327, 1.548 bp)
 *          Teste inverso: A. leari usou seed de A. hyacinthinus; agora o reverso.
 *
 * Objetivo: validação cruzada do pipeline — montagem independente
 * para comparação com a referência GenBank NC_082165.1.
 *
 * HOW TO RUN:
 *   nextflow run main.nf -profile a_hyacinthinus
 */

params {

    // ── Acesso SRA ──────────────────────────────────────────────────────────
    // Dataset metagenômico shotgun de fluido pericárdico de A. hyacinthinus:
    //   SRR36400750 — Shotgun metagenomic, NovaSeq X, paired-end 150 bp
    //   Total: 145.8M spots / 44.0G bases
    //   DNA extraído de fluido pericárdico da ave — contém DNA do hospedeiro
    //
    sra_accession = 'SRR36400750'

    // sra_max_reads não definido → Pilot QC analisa automaticamente
    // Para forçar: nextflow run main.nf -profile a_hyacinthinus --sra_max_reads 5000000

    // Semente: gene cox1 de A. leari (montagem do pipeline, 1.548 bp)
    // Teste inverso: A. leari usou seed de A. hyacinthinus → agora o reverso
    seed = "${projectDir}/data/seeds/a_leari_cox1.fasta"

    // Referência do Pilot QC para MEDIR a fração mitocondrial (não usada na
    // montagem). NC_082165.1 é conspecífica e independente: depositada por
    // outro grupo em 2023, a partir de outros dados e outro pipeline — é a
    // mesma sequência de OR209186.1, usada na validação do README. Ver DEC-06.
    pilot_reference = "${projectDir}/data/references/NC_082165.1.fasta"

    outdir = 'results/a_hyacinthinus'

    // ── NOVOPlasty — A. hyacinthinus mtDNA ────────────────────────────────
    // Referência NC_082165.1 tem 16.999 bp
    genome_range             = '15500-18500'
    novoplasty_kmers         = '39,33'
    novoplasty_max_iterations = 5
    k_mer                    = 39
    insert_size              = 300

    // ── Trimming ─────────────────────────────────────────────────────────
    trim_quality = 20
    min_length   = 50

    // ── MITOS2 (Fase 2) ─────────────────────────────────────────────
    mitos2_db    = "${projectDir}/data/databases/refseq89m"
    genetic_code = 2     // Vertebrado mitocondrial (ave)
    organism     = 'Anodorhynchus hyacinthinus'
}
